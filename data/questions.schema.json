{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A-1 / A-2 Question Data",
  "type": "object",
  "required": [
    "schema_version",
    "metadata",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "metadata": {
      "type": "object",
      "properties": {
        "dataset_version": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "code",
          "domain_id",
          "category_id",
          "subcategory_id",
          "subcategory",
          "difficulty",
          "priority",
          "question",
          "choices",
          "correct_choice",
          "explanation",
          "memory_point",
          "question_set",
          "source",
          "status",
          "schema_version"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "code": {
            "type": "string",
            "pattern": "^A[12]-[0-9]{3}$|^A2-PILOT-SC-[0-9]{4}-(SPRING|FALL|OCTOBER)-Q[0-9]{2}$"
          },
          "domain_id": {
            "type": "string",
            "minLength": 1
          },
          "category_id": {
            "type": "string",
            "minLength": 1
          },
          "subcategory_id": {
            "type": "string",
            "minLength": 1
          },
          "subcategory": {
            "type": "string",
            "minLength": 1
          },
          "difficulty": {
            "enum": [
              "基礎",
              "標準",
              "応用"
            ]
          },
          "priority": {
            "enum": [
              "S",
              "A",
              "B"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "choices": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "stimulus": {
                  "$ref": "#/$defs/stimulus"
                }
              },
              "additionalProperties": false
            }
          },
          "correct_choice": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "memory_point": {
            "type": "string",
            "minLength": 1
          },
          "question_set": {
            "type": "object"
          },
          "source": {
            "type": "object",
            "properties": {
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "verbatim_past_question": {
                "type": "boolean"
              },
              "source_id": {
                "type": "string",
                "pattern": "^[A-Z]{2,8}-[0-9]{4}-(SPRING|FALL|OCTOBER)-Q[0-9]{2}$"
              },
              "exam": {
                "type": "string",
                "minLength": 1
              },
              "year": {
                "type": "integer",
                "minimum": 2000,
                "maximum": 2100
              },
              "term": {
                "enum": [
                  "spring",
                  "fall",
                  "october"
                ]
              },
              "question_number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99
              },
              "official_question_url": {
                "type": "string",
                "pattern": "^https://(?:[a-z0-9-]+\\.)*ipa\\.go\\.jp/"
              },
              "official_answer_url": {
                "type": "string",
                "pattern": "^https://(?:[a-z0-9-]+\\.)*ipa\\.go\\.jp/"
              },
              "official_answer": {
                "enum": [
                  "ア",
                  "イ",
                  "ウ",
                  "エ"
                ]
              },
              "official_answer_choice_id": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              }
            }
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "schema_version": {
            "type": "integer",
            "minimum": 1
          },
          "stimulus": {
            "$ref": "#/$defs/stimulus"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "choice_explanations": {
            "type": "object",
            "required": [
              "A",
              "B",
              "C",
              "D"
            ],
            "properties": {
              "A": {
                "type": "string",
                "minLength": 1
              },
              "B": {
                "type": "string",
                "minLength": 1
              },
              "C": {
                "type": "string",
                "minLength": 1
              },
              "D": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "exam_tip": {
            "type": "string",
            "minLength": 1
          },
          "related_terms": {
            "type": "array",
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true,
        "not": {
          "required": [
            "dataset_version"
          ]
        }
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "stimulus": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "headers",
              "rows"
            ],
            "properties": {
              "type": {
                "const": "table"
              },
              "headers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "caption": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "content"
            ],
            "properties": {
              "type": {
                "const": "code"
              },
              "content": {
                "type": "string",
                "minLength": 1
              },
              "language": {
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "src",
              "alt",
              "asset_sha256"
            ],
            "properties": {
              "type": {
                "const": "image"
              },
              "src": {
                "type": "string",
                "pattern": "^questions/(sc|nw)/(a1|a2)/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(png|svg|jpg|jpeg|webp|avif|gif)$"
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "type": "string"
              },
              "asset_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "metadata": {
            "required": [
              "dataset_version"
            ],
            "properties": {
              "dataset_version": {
                "pattern": "^sc-a2-"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "questions": {
            "minItems": 1,
            "maxItems": 240,
            "items": {
              "required": [
                "content_hash",
                "subject_id"
              ],
              "properties": {
                "subject_id": {
                  "const": "a2"
                },
                "code": {
                  "pattern": "^A2-[0-9]{3}$"
                },
                "source": {
                  "required": [
                    "source_id",
                    "exam",
                    "year",
                    "term",
                    "question_number",
                    "official_question_url",
                    "official_answer_url",
                    "basis",
                    "type",
                    "verbatim_past_question"
                  ],
                  "properties": {
                    "exam": {
                      "const": "SC"
                    },
                    "type": {
                      "const": "official_past_question"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "questions": {
            "minItems": 240,
            "maxItems": 240
          }
        }
      }
    }
  ]
}
